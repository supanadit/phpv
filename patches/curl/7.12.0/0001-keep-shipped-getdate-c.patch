From: phpv <https://github.com/supanadit/phpv>
Subject: [PATCH] keep the shipped getdate.c instead of regenerating with Bison 3

curl 7.12.0 ships lib/getdate.c pre-generated by Bison 1.875a. Its
Makefile.in declares getdate.c a BUILT_SOURCE with a rule depending on
getdate.y, so `make` regenerates it with the runner's Bison 3.x. The new
skeleton changes the pure-parser yylex signature, and the build fails:

    y.tab.c: error: too few arguments to function 'Curl_gd_lex'
    y.tab.c: error: 'cookie' undeclared

The shipped parser is correct. Keep it unless it is actually missing.
---
 lib/Makefile.in | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/lib/Makefile.in b/lib/Makefile.in
index 5ef1f47..d3de2b4 100644
--- a/lib/Makefile.in
+++ b/lib/Makefile.in
@@ -701,10 +701,12 @@
 
 
 # Say $(srcdir), so GNU make does not report an ambiguity with the .y.c rule.
+# phpv: getdate.c ships pre-generated by Bison 1.875a and is correct.
+# Regenerating with a modern Bison (3.x) changes the pure-parser yylex
+# signature and the build fails in y.tab.c. Keep the shipped parser.
 $(srcdir)/getdate.c: getdate.y
-	cd $(srcdir) && \
-	  $(YACC) $(YFLAGS) getdate.y; \
-	  mv -f y.tab.c getdate.c
+	@if test -f $@; then touch $@; else \
+	  cd $(srcdir) && $(YACC) $(YFLAGS) getdate.y && mv -f y.tab.c getdate.c; fi
 
 $(top_builddir)/lib/ca-bundle.h: Makefile.in Makefile
 	@if test -f $@; then \
