From: phpv <https://github.com/supanadit/phpv>
Subject: [PATCH] PHP 4.3/4.4 compatibility with modern macOS arm64

Three old configure/codegen assumptions break on Apple Silicon:
SIZEOF_INT is not defined (so php_int32 has no typedef), and the
EXPANDED_* path variables are not substituted into build-defs.h (so
PHP_EXTENSION_DIR and PHP_CONFIG_FILE_SCAN_DIR are undefined). LP64
always has 32-bit ints, and empty path defaults are enough because the
INI values are used at runtime.
---
 a/ext/standard/basic_functions.h | 1 +
 a/ext/standard/dl.c | 3 +++
 a/ext/standard/info.c | 4 ++++
 3 files changed, 8 insertions(+)

--- a/ext/standard/basic_functions.h
+++ b/ext/standard/basic_functions.h
@@ -1 +1 @@
-#if SIZEOF_INT == 4
+#if defined(__LP64__) || SIZEOF_INT == 4
--- a/ext/standard/dl.c
+++ b/ext/standard/dl.c
@@ -102,7 +102,10 @@
 	zend_module_entry *module_entry, *tmp;
 	zend_module_entry *(*get_module)(void);
 	int error_type;
 	char *extension_dir;
+#ifndef PHP_EXTENSION_DIR
+#define PHP_EXTENSION_DIR ""
+#endif
 
 	if (type==MODULE_PERSISTENT) {
 		/* Use the configuration hash directly, the INI mechanism is not yet initialized */
--- a/ext/standard/info.c
+++ b/ext/standard/info.c
@@ -21,6 +21,10 @@
 
 /* $Id: info.c,v 1.218.2.18.2.10 2007/12/31 07:22:52 sebastian Exp $ */
 
+#ifndef PHP_CONFIG_FILE_SCAN_DIR
+#define PHP_CONFIG_FILE_SCAN_DIR ""
+#endif
+
 #include "php.h"
 #include "php_ini.h"
 #include "php_globals.h"
-- 
2.47.1

